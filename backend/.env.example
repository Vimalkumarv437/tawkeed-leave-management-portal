
# Application
APP_NAME=Leave Management Portal


# Database
# Local application database
DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# Separate database used by pytest
TEST_DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/leave_management_test


# Docker PostgreSQL
POSTGRES_DB=leave_management_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME


# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30


# CORS / Frontend

FRONTEND_URL=http://localhost:5173


# Login security
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15